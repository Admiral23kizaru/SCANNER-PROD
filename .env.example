APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Setup / provisioning (protects POST /api/setup/register-school)
SETUP_SECRET=change-this-to-a-long-random-string

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ehris2
DB_USERNAME=root
DB_PASSWORD=

# Laravel migration repository tbl (avoids clashing with EHRIS `migrations` when both live in ehris2)
DB_MIGRATIONS_TABLE=tbl_scanup_migrations

# Password reset tokens for ScanUp accounts (must match `tbl_scanup_password_resets`)
AUTH_PASSWORD_RESET_TOKEN_TABLE=tbl_scanup_password_resets

# EHRIS Database (read-only; same host/DB as mysql is OK — separate connection for EHRIS models)
EHRIS_DB_HOST=127.0.0.1
EHRIS_DB_PORT=3306
EHRIS_DB_DATABASE=ehris2
EHRIS_DB_USERNAME=root
EHRIS_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Scan-Up: Vue/Vite API base URL (Laravel backend)
VITE_APP_URL=http://127.0.0.1:8000
ASSET_URL=
VITE_APP_NAME="${APP_NAME}"
VITE_ASSET_PREFIX="${ASSET_URL}"
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://127.0.0.1:8000,http://localhost:8000

# Scan-Up: Reset admin password (php artisan scanup:reset-admin-password)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Scan-Up: Seeder only creates users when these are set (no hardcoded credentials)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_GUARD_EMAIL=
SEED_GUARD_PASSWORD=
